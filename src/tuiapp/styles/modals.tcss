BaseModal {
    align: center middle;
}

#modal-container {
    width: auto;
    height: auto;
    align: center middle;
    background: $panel;
    border: round $accent;
    padding: 2 4;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
}

#close {
    margin-top: 1;
}

PasswordHintsModal {
    #modal-body {
        text-style: italic;
    }

}

ConfirmationModal {
    #buttons-container {
        layout: vertical;
        width: auto;
        height: auto;
        align: center middle;
    }
}

DeleteAccountModal {
    #modal-container {
        border: round $error;
        layout: vertical; 

        #delete-icon {
            width: 100%;
            height: 3;
            text-align: center;
            content-align: center middle;
            color: white;
            margin: 0 0 2 0;
            background: $error;
            text-style: bold;
        }

        #modal-title {
            color: $error;
            text-align: center;
        }

        .field {
            width: 100%;
            height: auto;
            margin: 1 0;

            .field-label {
                margin-bottom: 1;
            }
        }

        #buttons-container {
            layout: vertical;
            width: auto;
            height: auto;
            align: center middle;
            margin-top: 2;
        }
    }
}

ExportDataModal {
    #modal-container {
        width: 60;
        height: 80%;
        max-height: 80%;
        layout: vertical;
        overflow-y: auto;

        #modal-title {
            color: $accent;
            text-align: center;
            text-style: bold;
        }

        #modal-description {
            text-align: center;
            margin-bottom: 1;
        }

        #selected-dir {
            text-style: bold;
            padding: 0 1;
            margin-bottom: 1;
        }

        #directory-tree {
            height: 2fr;
            min-height: 12;
            border: solid $border;
            margin-bottom: 1;
        }

        .field {
            width: 100%;
            height: auto;
            margin: 0 0 1 0;

            .field-label {
                margin-bottom: 1;
            }
        }

        #buttons-container {
            layout: vertical;
            width: 100%;
            height: auto;
            align: center middle;
            margin-top: 1;
        }

        #export, #close {
            width: 100%;
        }
    }
}