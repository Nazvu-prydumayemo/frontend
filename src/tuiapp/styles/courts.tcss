CourtCard {
    height: auto;
    max-height: 8;
    background: $panel;
    padding-left: 1;
    padding-right: 1;

    .court-card-name {
        text-style: bold;
        color: $accent;
    }

    .court-card-location {
        color: $foreground 50%;
    }

    .court-card-price {
        text-style: bold;
        color: $foreground 50%;
    }

    .court-card-type {
        color: $foreground 50%;
    }

    .court-card-body {
        height: auto;
    }
}

CourtCard:hover {
    background: $surface;
}

CardContainer {
    dock: left;
    width: 35;
    height: 100%;
    overflow-y: auto;
    border-right: solid $accent;
    align: left top;
    height: 100%;
    margin-top: 1;
}
