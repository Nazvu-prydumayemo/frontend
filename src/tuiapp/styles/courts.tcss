CourtCard {
    height: auto;
    max-height: 8;
    background: $panel;
    padding-left: 1;
    padding-right: 1;

    .court-card-name {
        text-style: bold;
        color: $accent;
    }

    .court-card-location {
        color: $foreground 50%;
    }

    .court-card-price {
        text-style: bold;
        color: $foreground 50%;
    }

    .court-card-type {
        color: $foreground 50%;
    }

    .court-card-body {
        height: auto;
    }
    
    .court-card-compact {
        display: none;
        color: $accent;
        text-style: bold italic;
    }
}
CourtCard:hover {
    background: $surface;
}
CourtCard.selected {
    outline: $accent vkey;
}

CardContainer {
    dock: left;
    width: 25%;
    min-width: 8;
    max-width: 45;
    height: 100%;
    overflow-y: auto;
    align: left top;
}