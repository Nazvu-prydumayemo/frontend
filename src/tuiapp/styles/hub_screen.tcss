#hub-container {
    height: 1fr;
    width: 100%;
    padding: 1 2;
}

CourtView {
    #court-scroll {
        height: 100%;
        width: 100%;
    }

    #court-header {
        width: 100%;
        height: auto;
        min-height: 5;
        background: $primary;
        layout: horizontal;
        margin-left: 1;
        margin-bottom: 1;
        padding: 1 2;
        align: left middle;
    }

    #court-header-info {
        width: 1fr;
        height: 100%;
        padding: 1 2;
    }

    #court-title {
        text-style: bold;
        color: $foreground;
    }

    #court-subtitle {
        color: $foreground 80%;
    }

    #court-body {
        height: auto;
        width: 100%;
        margin-left: 1;
    }

    #court-info-card {
        width: 2fr;
        height: auto;
        background: $panel;
        border: round $accent;
        padding: 1 2;
    }

    #court-info-title {
        text-style: bold;
        margin-bottom: 1;
    }

    .info-label {
        color: $foreground 50%;
        margin-top: 1;
        margin-bottom: 1;
    }

    .info-value {
        color: $foreground;
        text-style: bold;
        border: none;
        background: transparent;
        padding-left: 1;
        padding-right: 1;
        height: auto;
    }

    .info-value:focus {
        border: tall $accent;
        background: $panel-darken-1;
    }

    #court-orders-card {
        width: 1fr;
        height: auto;
        background: $panel;
        border: round $accent;
        padding: 2 3;
        content-align: center middle;
    }

    #wip-orders {
        text-style: bold;
        color: $foreground;
        width: 100%;
        content-align: center middle;
    }
}

CourtView.-narrow {
    #court-body {
        layout: vertical;
    }

    #court-info-card {
        width: 100%;
        margin-right: 0;
        margin-bottom: 1;
    }

    #court-orders-card {
        width: 100%;
    }
}